


<script type="text/javascript">
/* 진행중인 RFP 남은 시간 설정 */
function rcpnLimitTime(year, month, day, time, min,last, gubun , rfpId){
	jQuery(function(){
		var timeArea = jQuery('#rcpnTime_'+rfpId);
		var btnArea = jQuery("#rcpnBtn_"+rfpId);
		var ts = new Date(year, month, day, time, min);
		//var newYear = true;
		
		if((new Date()) > ts){
			ts = (new Date()).getTime() + 10*24*60*60*1000;
			//newYear = false;
		}
		
		jQuery('#rcpnTime_'+rfpId).countdown({
			timestamp	: ts,
			callback	: function(days, hours, minutes, seconds){
				days = days - last;
				var message;
				
				if(days < 0){
					message = '접수가 마감됐습니다.';
					timeArea.html(message);
					btnArea.find('a.btn').remove();
				}else if(days > 0){
					message = days + "일 ";// + hours + "시간 " +minutes + "분 " +  seconds + "초";
					timeArea.html(message);
				}else if(days <= 0 && hours > 0){
					message = hours + "시간 " +minutes + "분 " +  seconds + "초";
					timeArea.html(message);
				}else if(days <= 0 && hours <= 0 && minutes > 0){
					message = minutes + "분 " +  seconds + "초";
					timeArea.html(message);
				}else if(days <= 0 && hours <= 0 && minutes <= 0 && seconds > 0){
					message = seconds + "초";
					timeArea.html(message);
				}else{
					message = '접수기간이 아닙니다.';
					timeArea.html(message);
					btnArea.find('a.btn').remove();
				}
			}
		});
	});	
}
</script>
